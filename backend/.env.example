# Application
ENVIRONMENT=development
DEBUG=True

# Firebase
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_SERVICE_ACCOUNT_JSON=

# LLM Provider — Gemini is the ONLY active provider
LLM_PROVIDER=gemini

# -----------------------------------------------------------------------
# Gemini API — ALL text generation (itinerary, chat, diary, Q&A) + Vision
# -----------------------------------------------------------------------
# Multi-key rotation (RECOMMENDED): add as many keys as you have.
# When one key hits its quota (429), the next key is used automatically.
GEMINI_API_KEYS=AIzaKey1,AIzaKey2,AIzaKey3

# Single-key fallback (used only if GEMINI_API_KEYS is not set)
GEMINI_API_KEY=your-gemini-key

# Gemini model to use for all tasks
GEMINI_MODEL=gemini-2.5-flash

# PDF Diary export
DIARY_PDF_ENABLED=True

# Hugging Face Embeddings (for semantic memory — NOT for text generation)
HF_API_TOKEN=your-hf-token
HF_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# Places API
PLACE_PROVIDER=google
GOOGLE_PLACES_API_KEY=your-google-places-key
GEOAPIFY_API_KEY=your-geoapify-key
ENABLE_GEOAPIFY_FALLBACK=True
